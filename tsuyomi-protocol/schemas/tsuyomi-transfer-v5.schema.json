{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol.tsuyomi.dev/schema/tsuyomi-transfer-v5.schema.json",
  "title": "Tsuyomi Transfer v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "createdAt", "library", "shelves"],
  "properties": {
    "format": { "const": "tsuyomi-transfer" },
    "version": { "const": 5 },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "library": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/book" }
    },
    "shelves": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/shelf" }
    },
    "preferences": { "$ref": "#/$defs/preferences" }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "sourceId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$" },
    "remoteId": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "chapterId": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "remoteBookId"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/sourceId" },
        "remoteBookId": { "$ref": "#/$defs/remoteId" }
      }
    },
    "locatorDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "remoteBookId", "contentId"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/sourceId" },
        "remoteBookId": { "$ref": "#/$defs/remoteId" },
        "contentId": { "$ref": "#/$defs/remoteId" },
        "revision": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "readerLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "capturedAt"],
      "properties": {
        "document": { "$ref": "#/$defs/locatorDocument" },
        "blockId": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "textAnchorDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "characterOffset": { "type": "integer", "minimum": 0 },
        "chapterProgress": { "type": "number", "minimum": 0, "maximum": 1 },
        "bookProgress": { "type": "number", "minimum": 0, "maximum": 1 },
        "capturedAt": { "$ref": "#/$defs/timestamp" }
      },
      "anyOf": [
        { "properties": { "blockId": {}, "characterOffset": {} }, "required": ["blockId", "characterOffset"] },
        { "properties": { "blockId": {}, "textAnchorDigest": {} }, "required": ["blockId", "textAnchorDigest"] },
        { "properties": { "chapterProgress": {} }, "required": ["chapterProgress"] },
        { "properties": { "bookProgress": {} }, "required": ["bookProgress"] }
      ]
    },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "title", "localPin", "updatedAt", "bookmarks"],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "title": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "authors": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "canonicalUrl": { "type": "string", "format": "uri" },
        "coverUrl": { "type": "string", "format": "uri" },
        "status": { "enum": ["unknown", "ongoing", "completed", "hiatus", "cancelled"] },
        "remoteTags": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "localTags": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "shelfIds": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "readLater": { "type": "boolean" },
        "localPin": { "type": "boolean" },
        "addedAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "progress": { "$ref": "#/$defs/progress" },
        "completedChapterIds": {
          "type": "array",
          "maxItems": 20000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/chapterId" }
        },
        "bookmarks": {
          "type": "array",
          "maxItems": 20000,
          "items": { "$ref": "#/$defs/readerLocator" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "localPin": { "const": false } },
            "required": ["localPin"]
          },
          "then": {
            "properties": { "shelfIds": { "type": "array", "maxItems": 0 } }
          }
        }
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["updatedAt"],
      "properties": {
        "chapterId": { "$ref": "#/$defs/remoteId" },
        "textAnchor": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "characterOffset": { "type": "integer", "minimum": 0 },
        "chapterProgress": { "type": "number", "minimum": 0, "maximum": 1 },
        "bookProgress": { "type": "number", "minimum": 0, "maximum": 1 },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      },
      "anyOf": [
        { "properties": { "textAnchor": true }, "required": ["textAnchor"] },
        { "properties": { "characterOffset": true }, "required": ["characterOffset"] },
        { "properties": { "chapterProgress": true }, "required": ["chapterProgress"] },
        { "properties": { "bookProgress": true }, "required": ["bookProgress"] }
      ]
    },
    "shelf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "parentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "position": { "type": "integer", "minimum": 0 }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reader": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "flow": { "enum": ["scroll", "paged", "dual"] },
            "fontScale": { "type": "number", "minimum": 0.5, "maximum": 3 },
            "lineHeight": { "type": "number", "minimum": 0.8, "maximum": 3 },
            "theme": { "enum": ["paper", "warmGray", "nightInk", "black", "inkGreen"] },
            "horizontalMargin": { "type": "number", "minimum": 12, "maximum": 40 },
            "paragraphSpacing": { "type": "number", "minimum": 0, "maximum": 32 },
            "lockPortrait": { "type": "boolean" },
            "progressVisible": { "type": "boolean" },
            "immersive": { "type": "boolean" },
            "keepAwake": { "type": "boolean" },
            "volumePaging": { "type": "boolean" },
            "fontFamily": { "enum": ["system", "sans", "serif", "monospace"] },
            "fontWeight": { "enum": [400, 500] },
            "letterSpacing": { "type": "number", "minimum": -0.05, "maximum": 0.2 },
            "firstLineIndent": { "type": "number", "minimum": 0, "maximum": 4 },
            "verticalMargin": { "type": "number", "minimum": 0, "maximum": 64 },
            "textAlignment": { "enum": ["start", "justify", "center", "end"] },
            "foregroundColor": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
            "backgroundColor": { "type": "string", "pattern": "^#[0-9A-F]{6}$" }
          }
        }
      }
    }
  }
}
