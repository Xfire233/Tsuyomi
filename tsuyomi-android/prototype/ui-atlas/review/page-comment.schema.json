{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsuyomi.invalid/schemas/interactive-node-comment-v2.json",
  "title": "Tsuyomi interactive prototype review node comment",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodeId", "route", "author", "comment", "lastEditedContext"],
  "properties": {
    "nodeId": {"type": "string", "pattern": "^[LBMSX][0-9]{2}$"},
    "route": {"type": "string", "minLength": 1},
    "author": {"enum": ["ai", "human", "mixed"]},
    "comment": {"type": "string", "minLength": 1},
    "staleBuildId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lastEditedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "theme", "state", "recentEvents", "updatedAt"],
      "properties": {
        "profile": {"enum": ["standard", "eink"]},
        "theme": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1},
        "overlay": {"type": ["string", "null"]},
        "layout": {"type": ["string", "null"]},
        "libraryView": {"type": ["string", "null"]},
        "lastAction": {"type": ["string", "null"]},
        "recentEvents": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string"}
        },
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
