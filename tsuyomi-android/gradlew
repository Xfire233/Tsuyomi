#!/bin/sh
# SPDX-FileCopyrightText: 2026 Tsuyomi Contributors
# SPDX-License-Identifier: Apache-2.0

# Gradle start-up script for POSIX generated by Gradle 8.14.3.
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ -n "$JAVA_HOME" ]; then
    JAVACMD=$JAVA_HOME/bin/java
else
    JAVACMD=java
fi

if ! command -v "$JAVACMD" >/dev/null 2>&1; then
    echo "ERROR: JAVA_HOME is not set and no 'java' command could be found." >&2
    exit 1
fi

exec "$JAVACMD" ${JAVA_OPTS:+$JAVA_OPTS } ${GRADLE_OPTS:+$GRADLE_OPTS } -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
