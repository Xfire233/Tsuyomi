    <string name="settings_help_later">稍后再看</string>
    <string name="settings_help_question_offline">为什么来源页面要求登录验证？</string>
    <string name="settings_help_answer_offline">网站会话失效或页面要求人工验证时，Tsuyomi 不会绕过验证。可以进入登录验证，或显式使用已缓存内容。</string>
    <string name="settings_help_question_cache">缓存包含什么？</string>
    <string name="settings_help_answer_cache">缓存保存已验证的来源目录、详情、章节与图片，用于显式离线读取；缓存不是书架或进度的权威数据。</string>
    <string name="settings_help_question_remote">网站收藏会自动修改网站吗？</string>
    <string name="settings_help_answer_remote">不会。读取、复制到本地和网站写入是不同操作；网站新增、移动或移除始终需要明确动作与授权。</string>
    <string name="settings_help_question_reset">重置界面会删除数据吗？</string>
    <string name="settings_help_answer_reset">不会。界面重置不触碰书籍、收藏夹、进度、来源、凭据、镜像或缓存。</string>
    <string name="settings_help_intro_mirror_title">网站镜像</string>
    <string name="settings_help_intro_mirror_summary">在书架中查看已显式同步的网站收藏。</string>
    <string name="settings_help_intro_mirror_point_1">镜像默认按来源显示为一个网站收藏；分组需要逐来源开启。</string>
    <string name="settings_help_intro_mirror_point_2">复制到本地不会修改网站；拖入网站目标属于明确的网站写入。</string>
    <string name="settings_help_intro_updates_title">书架更新</string>
    <string name="settings_help_intro_updates_summary">在书架根页检查并筛选有新章节的书籍。</string>
    <string name="settings_help_intro_updates_point_1">下拉刷新或刷新操作会检查全部符合条件的书籍；打开书架不会自动请求来源。</string>
    <string name="settings_help_intro_updates_point_2">新章节会以精确数量显示；读完本批全部新章或忽略当前批次后才会消失。</string>
    <string name="settings_help_intro_smart_title">智能收藏夹</string>
    <string name="settings_help_intro_smart_summary">用本地规则组织已经进入书架的数据。</string>
    <string name="settings_help_intro_smart_point_1">规则只读取本地书架字段，不运行来源代码或网络请求。</string>
    <string name="settings_help_intro_smart_point_2">条件组合始终可编辑，不会改变网站收藏。</string>
    <string name="settings_help_intro_writeback_title">网站收藏写入</string>
    <string name="settings_help_intro_writeback_summary">明确区分本地加入与网站新增、移动、移除。</string>
    <string name="settings_help_intro_writeback_point_1">普通“加入书架”只写本地。</string>
    <string name="settings_help_intro_writeback_point_2">网站操作需要当前能力、会话和逐操作授权；结果不确定时必须显式处理。</string>
    <string name="settings_help_intro_data_title">数据导入与导出</string>
    <string name="settings_help_intro_data_summary">先审阅，再确认本地数据变更。</string>
    <string name="settings_help_intro_data_point_1">凭据、网页状态、镜像运行态和缓存不会进入迁移文件。</string>
    <string name="settings_help_intro_data_point_2">取消文件选择器或确认页面不会改变现有数据。</string>

